#!/usr/bin/env python3
"""
Lets test/nfs-cluster.nix restart the servers on the machine it runs on,
for test/ci-host.sh. Run as root:

  host-control --log LOG --user USER -- COMMAND...

runs COMMAND, the metadata service, as USER, with its output appended to
LOG, and answers on 127.0.0.1:8081, where the test's VMs reach it at
10.0.2.2:8081:

  POST /v1/kill-service {"down": SECONDS}
      Kill the service with SIGKILL, so that whatever it was doing is cut
      short, and start it again SECONDS later.
  POST /v1/restart-nfsd
      Restart the NFS server. Stopping nfsd drops every client's state, and
      starting it begins a grace period in which clients reclaim it.
"""

import argparse
import json
import subprocess
import sys
import threading
import time
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer


class Service:
    def __init__(self, command, user, log):
        self.command, self.user, self.log = command, user, log
        self.lock = threading.Lock()
        self.proc = None
        self.start()

    def start(self):
        with self.lock, open(self.log, "ab") as log:
            self.proc = subprocess.Popen(self.command, user=self.user, stdout=log, stderr=log)
            print(f"host-control: started the service, pid {self.proc.pid}", file=sys.stderr, flush=True)

    def kill(self, down):
        with self.lock:
            pid = self.proc.pid
            self.proc.kill()
            self.proc.wait()
        print(f"host-control: killed the service, pid {pid}; starting it again in {down}s", file=sys.stderr, flush=True)
        threading.Timer(down, self.start).start()
        return {"killed": pid}


def restart_nfsd(req):
    start = time.monotonic()
    subprocess.run(["systemctl", "restart", "nfs-kernel-server"], check=True)
    took = time.monotonic() - start
    print(f"host-control: restarted nfsd in {took:.1f}s", file=sys.stderr, flush=True)
    return {"seconds": took}


class Handler(BaseHTTPRequestHandler):
    def do_POST(self):
        body = self.rfile.read(int(self.headers.get("Content-Length", 0)))
        routes = {
            "/v1/kill-service": lambda req: self.server.service.kill(float(req.get("down", 0))),
            "/v1/restart-nfsd": restart_nfsd,
        }
        try:
            if self.path not in routes:
                return self.reply(404, {"error": f"no such endpoint {self.path}"})
            self.reply(200, routes[self.path](json.loads(body or b"{}")))
        except Exception as e:
            self.reply(500, {"error": str(e)})

    def reply(self, status, obj):
        data = json.dumps(obj).encode()
        self.send_response(status)
        self.send_header("Content-Type", "application/json")
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        self.wfile.write(data)


def main():
    parser = argparse.ArgumentParser(description=__doc__.strip().splitlines()[0])
    parser.add_argument("--log", required=True, help="append the service's output here")
    parser.add_argument("--user", required=True, help="run the service as this user")
    parser.add_argument("--listen", default="127.0.0.1:8081", help="HOST:PORT")
    parser.add_argument("command", nargs="+", help="the metadata service's command line")
    args = parser.parse_args()

    host, _, port = args.listen.rpartition(":")
    server = ThreadingHTTPServer((host, int(port)), Handler)
    server.daemon_threads = True
    server.service = Service(args.command, args.user, args.log)
    server.serve_forever()


if __name__ == "__main__":
    main()
